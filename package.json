{
  "name": "mdink-workspace",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "build:web": "./scripts/build-web.sh",
    "build:packages": "./scripts/build-web.sh",
    "build:site": "pnpm --dir site run build",
    "capture:web": "pnpm run build:site && node scripts/capture-web.mjs",
    "capture:cross-platform": "./scripts/capture-cross-platform.sh",
    "capture:native-hero": "./scripts/capture-native-hero-videos.sh",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "pack:check": "node scripts/check-package-tarballs.mjs",
    "preview:site": "pnpm --dir site run preview",
    "release:npm": "changeset publish",
    "version:packages": "changeset version",
    "test": "./scripts/test.sh"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1"
  }
}
