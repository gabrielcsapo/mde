{
  "name": "mde-workspace",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "build:web": "./scripts/build-web.sh",
    "build:site": "pnpm --dir site run build",
    "capture:web": "pnpm run build:site && node scripts/capture-web.mjs",
    "capture:cross-platform": "./scripts/capture-cross-platform.sh",
    "preview:site": "pnpm --dir site run preview",
    "test": "./scripts/test.sh"
  }
}
