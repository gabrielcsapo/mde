{
  "name": "@mde/web",
  "version": "0.1.0",
  "description": "Framework-free inline markdown editor powered by the mde Rust core.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./theme.css",
    "./extensions.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin-testing": {
      "types": "./dist/types/src/plugin-testing.d.ts",
      "import": "./dist/plugin-testing.js"
    },
    "./theme.css": "./src/theme.css",
    "./extensions.css": "./extensions/extensions.css",
    "./mde.wasm": "./dist/mde.wasm",
    "./extensions/typewriter": {
      "types": "./dist/types/extensions/typewriter.d.ts",
      "import": "./dist/extensions/typewriter.js"
    },
    "./extensions/parts-of-speech": {
      "types": "./dist/types/extensions/parts-of-speech.d.ts",
      "import": "./dist/extensions/parts-of-speech.js"
    },
    "./extensions/suggestions": {
      "types": "./dist/types/extensions/suggestions.d.ts",
      "import": "./dist/extensions/suggestions.js"
    },
    "./extensions/productivity": {
      "types": "./dist/types/extensions/productivity.d.ts",
      "import": "./dist/extensions/productivity.js"
    },
    "./extensions/journal-attachments": {
      "types": "./dist/types/extensions/journal-attachments.d.ts",
      "import": "./dist/extensions/journal-attachments.js"
    },
    "./extensions/composer": {
      "types": "./dist/types/extensions/composer.d.ts",
      "import": "./dist/extensions/composer.js"
    },
    "./extensions/examples": {
      "types": "./dist/types/extensions/examples.d.ts",
      "import": "./dist/extensions/examples.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/theme.css",
    "extensions/extensions.css",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run typecheck && vite build && pnpm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:performance": "MDE_PERF=1 vitest run test/performance.browser.test.js --disableConsoleIntercept",
    "test:performance:media": "vitest run test/media-pipeline-performance.browser.test.js --disableConsoleIntercept",
    "test:performance:extended": "MDE_PERF_EXTENDED=1 vitest run test/extended-performance.browser.test.js --disableConsoleIntercept",
    "test:performance:lifecycle": "MDE_PERF_LIFECYCLE=1 vitest run test/lifecycle-performance.browser.test.js --disableConsoleIntercept",
    "test:all-browsers": "MDE_BROWSERS=chromium vitest run && MDE_BROWSERS=firefox vitest run && MDE_BROWSERS=webkit vitest run",
    "test:watch": "vitest --browser.headless=false",
    "test:install-browser": "playwright install chromium",
    "test:install-all-browsers": "playwright install chromium firefox webkit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "markdown",
    "editor",
    "contenteditable",
    "typescript",
    "wasm"
  ],
  "dependencies": {
    "@mde/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
