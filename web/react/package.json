{
  "name": "@mdink/react",
  "version": "0.1.0",
  "description": "Optional React adapter for the framework-free @mdink/web markdown editor.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@mdink/web": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "markdown",
    "editor",
    "react",
    "contenteditable",
    "wasm"
  ]
}
